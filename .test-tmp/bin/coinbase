#!/usr/bin/env bash
printf '%s\n' "$*" >> "${STUB_LOG:-/dev/null}"
case "$1" in
  --version) echo "0.0.11" ;;
  env) printf 'Environments:\n* live  (Coinbase App & Advanced Trade)  Key: abc…xyz  Brokerage: https://api.coinbase.com\n' ;;
  api-key) echo '{"can_view":true,"can_trade":true,"can_transfer":true,"portfolio_type":"CONSUMER"}' ;;
  balance) echo '{"accounts":[{"currency":"USD","available_balance":{"value":"0"}}]}' ;;
  *) echo '{}' ;;
esac
