#!/usr/bin/env bash
# CB_GUARD_V1 —— 这个标记用来判断"当前这个 coinbase 是不是守卫"，
# 开机自检靠它发现被 npm 覆盖掉的守卫并重新装上。
# coinbase — 占住 coinbase 这个名字的守卫：拦"提交订单"，也接管 mcp 子命令。
#
# 为什么需要它：cb-trade.sh 会过风控，但 agent 也可以直接调
# `coinbase orders create …`，那就绕过了所有限额。这个 wrapper 把
# create 这一个子命令接住：kill switch 开着或产品不在白名单时直接拒绝，
# 否则原封不动交给真正的 coinbase。
#
# 拦什么、不拦什么（故意的）：
#   - 拦 orders create 的 kill switch 与产品白名单 —— 这两个判断只看本地状态，
#     不需要价格，所以能在不额外打 API 的前提下拦住。
#   - 不在这里算金额限额：市价单的名义金额要查行情才知道，而 wrapper 每拦一次
#     就多打一次 API 是本末倒置。金额限额归 cb-trade.sh，它本来就查过价格。
#   - 其它子命令一律透明转发，包括 orders preview（只读）。

set -uo pipefail

SELF=$(cd "$(dirname "$0")" && pwd)

# 找真正的 coinbase。三种顺序，前两种都不依赖 PATH 顺序 ——
# 因为 ssh 的非登录 shell、cron、别的进程拿到的 PATH 各不相同，
# 指望"把守卫目录排在前面"是不可靠的。
#   1) 环境变量 CB_REAL_COINBASE（显式指定，排查时好用）
#   2) 同目录下的 coinbase-real.js（安装时把真程序改名；必须是 .js ——
#      这个 CLI 是 Node ESM 脚本，改成别的扩展名 node 会拒绝执行：
#      ERR_UNKNOWN_FILE_EXTENSION。coinbase.real 作为旧名兼容保留）
#   3) 沿 PATH 找，跳过本文件所在目录（避免自己 exec 自己）
#   0) 【优先】包里的原始入口。这个 CLI 用 import.meta.url 找自己捆绑的
#      skills/ 目录，把入口复制到 /usr/local/bin 之后它会去 /usr/local/bin/skills
#      找，于是 `coinbase skills list` 谎报 "No bundled skills found"、
#      `skills add` 装 0 个 —— 静默失效，比报错更难发现。所以只要能找到包里
#      的原始入口就优先用它，复制品只作为兜底。
REAL=""
if [ -n "${CB_REAL_COINBASE:-}" ] && [ -x "${CB_REAL_COINBASE}" ]; then
  REAL=$CB_REAL_COINBASE
fi
if [ -z "$REAL" ]; then
  # npm 全局前缀的常见位置 + npm 自己报告的 root（缓存文件由安装脚本写）
  _cands=""
  [ -f "${SELF}/coinbase-pkg-root" ] && _cands=$(cat "${SELF}/coinbase-pkg-root" 2>/dev/null)
  for _r in ${_cands} \
              "${NPM_CONFIG_PREFIX:-/usr/local}/lib/node_modules" \
              "/usr/local/lib/node_modules" \
              "/usr/lib/node_modules" \
              "${HOME:-/root}/.npm-global/lib/node_modules"; do
    _e="$_r/@coinbase/coinbase-cli/dist/index.js"
    if [ -f "$_e" ]; then REAL=$_e; break; fi
  done
fi
if [ -n "$REAL" ]; then
  :
elif [ -x "${SELF}/coinbase-real.js" ]; then
  REAL="${SELF}/coinbase-real.js"
elif [ -x "${SELF}/coinbase.real" ]; then
  REAL="${SELF}/coinbase.real"
else
  IFS=':' read -r -a _paths <<< "${PATH:-/usr/local/bin:/usr/bin:/bin}"
  for d in "${_paths[@]}"; do
    [ -n "$d" ] || continue
    cand="$d/coinbase"
    [ -x "$cand" ] || continue
    [ "$(cd "$d" && pwd)" = "$SELF" ] && continue
    REAL=$cand
    break
  done
fi

if [ -z "$REAL" ]; then
  echo "coinbase-guard: 找不到真正的 coinbase（同目录的 coinbase-real.js、CB_REAL_COINBASE、PATH 都没有）" >&2
  echo "                PATH=${PATH}" >&2
  exit 127
fi

# `coinbase mcp` 是另一条下单路径：MCP server 在自己进程里直接调 API，
# 二进制守卫拦不到它。所以这条命令改走 mcp 代理，由代理去审 JSON-RPC 里的
# tools/call。代理不存在时**拒绝**而不是放行 —— 没有闸门的 mcp 等于没有风控。
if [ "${1:-}" = "mcp" ]; then
  PROXY="${SELF}/coinbase-mcp-proxy.mjs"
  if [ -f "$PROXY" ]; then
    CB_REAL_COINBASE="$REAL" exec node "$PROXY" "${@:2}"
  fi
  echo "coinbase-guard: 找不到 MCP 代理 $PROXY，拒绝启动 mcp（没有闸门的 mcp 不启动）" >&2
  exit 78
fi

# 只有 orders create / orders cancel 这类会改变状态的动作才需要过闸；
# 其余（--version、balance、products …）直接放行。
is_mutating=0
if [ "${1:-}" = "orders" ]; then
  case "${2:-}" in
    create|cancel) is_mutating=1 ;;
  esac
fi

# 加载风控库：找不到就 exit 78，绝不"拦不住还放行"
load_lib() {
  LIB=""
  for cand in "${SELF}/../scripts/lib" "${SELF}/../lib" "$HOME" "$HOME/lib"; do
    if [ -r "${cand}/risk.sh" ] && [ -r "${cand}/config.sh" ]; then LIB=$(cd "$cand" && pwd); break; fi
  done
  if [ -z "$LIB" ]; then
    echo "coinbase-guard: 找不到风控库（risk.sh/config.sh），为安全起见拒绝执行 ${1:-这次操作}。" >&2
    echo "                把这些脚本装上，或临时移出 PATH 以绕过（你知道你在做什么）。" >&2
    exit 78
  fi
  # shellcheck source=/dev/null
  . "${LIB}/config.sh"
  # shellcheck source=/dev/null
  . "${LIB}/risk.sh"
}

# 从参数里取一个字段：既认 `k=v` 也认 `k==v` 和 `--k==v`
arg_field() { # arg_field <键> <参数...>
  local k=$1; shift
  local a
  for a in "$@"; do
    case "$a" in
      "${k}=="*) printf '%s' "${a#*=}" | sed 's/^=//'; return 0 ;;
      "${k}="*)  printf '%s' "${a#*=}"; return 0 ;;
      "--${k}=="*) printf '%s' "${a#*=}" | sed 's/^=//'; return 0 ;;
      "--${k}="*)  printf '%s' "${a#*=}"; return 0 ;;
    esac
  done
  return 1
}

# x402 花钱：shell 直连 `coinbase x402 fetch/pay` 绕不过 kill switch
if [ "${1:-}" = "x402" ]; then
  case "${2:-}" in
    fetch|pay)
      load_lib "x402 ${2}"
      if cb_risk_killed; then
        cb_risk_journal_add block "X402" BUY x402 0 deny "kill switch 开着（coinbase-guard）"
        echo "✗ 风控：kill switch 开着，x402 ${2} 被拒绝。（恢复：cb-risk.sh resume）" >&2
        exit 4
      fi
      ;;
  esac
  exec "$REAL" "$@"
fi

# transfer 在组合之间搬钱：同样会改变余额，且 agent 可以直接调
if [ "${1:-}" = "transfer" ]; then
  case " $* " in
    *" --dry-run "*) exec "$REAL" "$@" ;;   # 只预览，不动钱
  esac
  load_lib "transfer"
  if cb_risk_killed; then
    cb_risk_journal_add block "TRANSFER" "?" transfer 0 deny "kill switch 开着（coinbase-guard）"
    echo "✗ 风控：kill switch 开着，transfer 被拒绝。（恢复：cb-risk.sh resume）" >&2
    exit 4
  fi
  _amt=$(arg_field amount "$@" || true)
  _cur=$(arg_field currency "$@" || true)
  _notional=0
  case "$(printf '%s' "${_cur:-}" | tr '[:lower:]' '[:upper:]')" in
    USD|USDC|USDT|DAI|PYUSD)
      # 稳定币按 1:1 当美元算，这是唯一能不看行情就判断金额的情况
      _notional=${_amt:-0} ;;
    "")
      echo "✗ 风控：transfer 认不出 currency —— 判断不了金额，已拒绝。" >&2
      exit 78 ;;
    *)
      if [ "$(cb_risk_cfg allow_non_usd_transfer false)" != "true" ]; then
        cb_risk_journal_add block "TRANSFER:${_cur}" "?" transfer 0 deny "非稳定币 transfer 未授权（coinbase-guard）"
        echo "✗ 风控：transfer 的币种 ${_cur} 不是稳定币，金额无法折成美元，默认不允许。" >&2
        echo "        确认要允许：cb-risk.sh set allow_non_usd_transfer true" >&2
        exit 4
      fi ;;
  esac
  _lim=$(cb_risk_cfg max_transfer_usd "$(cb_risk_cfg max_single_trade_usd "")")
  if [ -n "${_lim:-}" ] && [ "${_notional:-0}" != "0" ]; then
    if python3 -c "import sys; sys.exit(0 if float('${_notional}') <= float('${_lim}') else 1)" 2>/dev/null; then :; else
      cb_risk_journal_add block "TRANSFER:${_cur}" "?" transfer "${_notional}" deny "超过 transfer 上限 ${_lim}（coinbase-guard）"
      echo "✗ 风控：transfer ${_amt} ${_cur} 超过上限 ${_lim} USD，已拒绝。" >&2
      echo "        调整：cb-risk.sh set max_transfer_usd <金额>" >&2
      exit 4
    fi
  fi
  cb_risk_journal_add exec "TRANSFER:${_cur:-?}" "?" transfer "${_notional}" submitted "guard 放行"
  exec "$REAL" "$@"
fi

if [ "$is_mutating" -eq 1 ]; then
  load_lib "orders ${2}"

  if cb_risk_killed; then
    cb_risk_journal_add block "${CB_GUARD_PRODUCT:-unknown}" "${CB_GUARD_SIDE:-?}" "guard" "0" deny "kill switch 开着（coinbase-guard）"
    echo "✗ 风控：kill switch 开着，orders ${2} 被拒绝。（恢复：cb-risk.sh resume）" >&2
    exit 4
  fi

  allow=$(cb_risk_cfg allowed_products "")
  if [ -n "$allow" ]; then
    # 产品参数可能写成 product_id==BTC-USD、product_id=BTC-USD 或 --product_id==…，
    # 三种都要认。认不出来时**拒绝**：白名单开着却判断不了产品，放行等于没有白名单。
    prod=""
    for a in "$@"; do
      case "$a" in
        product_id==*)   prod=${a#product_id==} ;;
        product_id=*)    prod=${a#product_id=} ;;
        --product_id==*) prod=${a#--product_id==} ;;
        --product_id=*)  prod=${a#--product_id=} ;;
      esac
      [ -n "$prod" ] && break
    done
    if [ -z "$prod" ]; then
      cb_risk_journal_add block "unknown" "?" "guard" "0" deny "白名单开着但认不出 product_id（coinbase-guard）"
      echo "✗ 风控：白名单开着，但这笔 orders ${2} 认不出 product_id —— 无法判断是否放行，已拒绝。" >&2
      echo "        白名单：${allow}。临时放行请先 cb-risk.sh set allowed_products ''" >&2
      exit 78
    fi
    case ",$(printf '%s' "$allow" | tr -d ' ')," in
      *",$prod,"*) ;;
      *)
        cb_risk_journal_add block "$prod" "?" "guard" "0" deny "不在白名单（coinbase-guard）"
        echo "✗ 风控：${prod} 不在白名单 ${allow}，orders ${2} 被拒绝。" >&2
        exit 4 ;;
    esac
  fi
fi

exec "$REAL" "$@"
